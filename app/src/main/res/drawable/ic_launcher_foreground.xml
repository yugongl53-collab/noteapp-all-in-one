<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应应用图标前景层：品牌 N 字母主干、灵感笔尖与书写光笔 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:translateX="72"
        android:translateY="56">
        <!-- N 字母左侧竖线 -->
        <path
            android:pathData="M72,288 L72,120"
            android:strokeWidth="38"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />

        <!-- N 字母对角能量跃升折线 -->
        <path
            android:pathData="M72,120 L208,264"
            android:strokeWidth="38"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="72"
                    android:startY="120"
                    android:endX="208"
                    android:endY="264"
                    android:type="linear">
                    <item android:color="#FFA5B4FC" android:offset="0.0" />
                    <item android:color="#FFFFFFFF" android:offset="0.5" />
                    <item android:color="#FF67E8F9" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- N 字母右侧竖线 -->
        <path
            android:pathData="M208,264 L208,96"
            android:strokeWidth="38"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />

        <!-- 灵感火花 / 笔尖焦点 -->
        <path
            android:pathData="M256,116 A24,24 0 1,0 304,116 A24,24 0 1,0 256,116 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="256"
                    android:startY="92"
                    android:endX="304"
                    android:endY="140"
                    android:type="linear">
                    <item android:color="#FFFDE047" android:offset="0.0" />
                    <item android:color="#FFF97316" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 提笔书写光笔线 -->
        <path
            android:pathData="M280,164 L280,288"
            android:strokeWidth="34"
            android:strokeColor="#FF5EEAD4"
            android:strokeLineCap="round" />
    </group>
</vector>
